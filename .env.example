# Copy this file to .env and fill in real values.
# Never commit .env. In GitHub Actions, set these as repository secrets.

# Postgres owner connection (Neon, direct, no -pooler). Used ONLY by the migration runner.
DATABASE_URL=postgresql://neondb_owner:password@host/neondb?sslmode=require

# Limited logins, one per job. Written automatically by:
#   uv run python migrations/logins.py --env-file .env
INGEST_DATABASE_URL=postgresql://delphi_ingest:password@host/neondb?sslmode=require
QUERY_DATABASE_URL=postgresql://delphi_query:password@host/neondb?sslmode=require
EVAL_DATABASE_URL=postgresql://delphi_eval:password@host/neondb?sslmode=require

# Answer model (Claude API). litellm format: provider/model.
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=anthropic/claude-haiku-5-5

# Gray-zone cache judge (a small, cheap model)
JUDGE_MODEL=anthropic/claude-haiku-5-5

# Embeddings (Anthropic has no embedding model). litellm format.
VOYAGE_API_KEY=your-voyage-key-here
EMBEDDING_MODEL=voyage/voyage-3.5

# Cost guardrail: stop a job if its model spend passes this (USD)
DAILY_SPEND_CAP_USD=0.25
